generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DocumentType {
  tn
  ttn
  other
}

model Supplier {
  id        String     @id
  name      String
  email     String     @unique
  documents Document[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Document {
  id              String       @id @default(cuid())
  type            DocumentType
  supplierId      String
  supplier        Supplier     @relation(fields: [supplierId], references: [id])
  number          String?
  date            DateTime?
  totalSumWithVat Decimal
  items           Json
  source          String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}
